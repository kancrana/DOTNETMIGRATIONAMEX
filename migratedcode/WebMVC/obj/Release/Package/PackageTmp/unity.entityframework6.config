<unity xmlns="http://schemas.microsoft.com/practices/2010/unity">
  <assembly name="eShop.Web"/>
  <namespace name="eShop.Web.Services" />

  <typeAliases>
    <typeAlias alias="singleton" type="Microsoft.Practices.Unity.ContainerControlledLifetimeManager, Microsoft.Practices.Unity"/>
    <typeAlias alias="hierarchical" type="Microsoft.Practices.Unity.HierarchicalLifetimeManager, Microsoft.Practices.Unity"/>
  </typeAliases>

  <containers>
    <container name="Services">
      <register type="IProductListingService" mapTo="ProductListingService" >
        <lifetime type="singleton" />
      </register>
      <register type="ICartService" mapTo="CartService">
        <lifetime type="singleton" />
      </register>
    </container>
  </containers>
</unity>